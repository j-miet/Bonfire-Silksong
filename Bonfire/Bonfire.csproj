<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>Bonfire</AssemblyName>
    <RootNamespace>Bonfire</RootNamespace>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Required dlls: DLL files from game's own Managed directory + ones from BepInEx 
    This path assumes you have already installed BepInEx in game path e.g.
    C:\Program Files (x86)\Steam\steamapps\common\Hollow Knight Silksong\BepInEx
  -->
  <PropertyGroup>
    <SilksongPath>C:\Program Files (x86)\Steam\steamapps\common\Hollow Knight Silksong</SilksongPath>
    <ManagedRefs>$(SilksongPath)\Hollow Knight Silksong_Data\Managed</ManagedRefs>
    <BepInExRefs>$(SilksongPath)\BepInEx\core</BepInExRefs>
  </PropertyGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll;$(OutputPath)$(AssemblyName).pdb"
          DestinationFolder="$(SilksongPath)\BepInEx\plugins\Bonfire" />
  </Target>

  <ItemGroup>
    <!-- BepInEx -->
    <Reference Include="BepInEx">
      <HintPath>$(BepInExRefs)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExRefs)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Managed -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedRefs)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedRefs)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedRefs)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>$(ManagedRefs)\UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PlayMaker">
      <HintPath>$(ManagedRefs)\PlayMaker.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedRefs)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedRefs)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>